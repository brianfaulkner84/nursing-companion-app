NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Roles (student/instructor/admin) now live in profiles.role, set via beta code redemption --
# see supabase/migrations/20260807080000_add_roles_and_schools.sql. ADMIN_EMAIL is your
# permanent admin guarantee, not just a fallback for a missing profile row: lib/roles.ts
# checks it on every request and forces role to 'admin' for a matching email regardless of
# what profiles.role says in the database. So even a bad migration, a wrong manual SQL update,
# or an accidental role change some other way can't lock you out -- as long as this stays set
# to your email in Vercel, you're always admin the moment you sign in. Must exactly match the
# email your Google sign-in uses.
ADMIN_EMAIL=brian.faulkner84@gmail.com
RESEND_API_KEY=
# NOTIFY_EMAIL is where system notifications land -- keep this your personal inbox
# (brian.faulkner84@gmail.com), not a public alias. It's never shown to students or
# instructors anywhere in the app, it's only the destination for backend-triggered emails
# (new raised hand, 24-hour escalation), so there's no exposure risk in using your real address.
# If you later need a public support contact for the Play Store listing or a footer link, set
# that up separately -- it doesn't need to be, and shouldn't be, the same address as this one.
NOTIFY_EMAIL=brian.faulkner84@gmail.com
# Sending domain for Resend is lpnlaunchpad.com, verified there once DNS records are added in Cloudflare.
# Outgoing raised-hand and reminder emails are sent FROM questions@lpnlaunchpad.com (set in the
# route code, not here) but always TO NOTIFY_EMAIL above -- the public-looking sender address and
# the private destination address are two different things.
CRON_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Signing secret for the /api/stripe-webhook endpoint, from the webhook's settings page in
# the Stripe dashboard once it's created (Developers > Webhooks). Different value for test
# mode vs live mode, and different again for the Stripe CLI if testing locally.
STRIPE_WEBHOOK_SECRET=
